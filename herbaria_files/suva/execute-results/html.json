ollapsed\":false,\"autoZIndex\":true,\"position\":\"topright\"}]},{\"method\":\"addLegend\",\"args\":[{\"colors\":[\"#0E6B6F\"],\"labels\":[\"Herbaria\"],\"na_color\":null,\"na_label\":\"NA\",\"opacity\":1,\"position\":\"bottomleft\",\"type\":\"unknown\",\"title\":null,\"extra\":null,\"layerId\":null,\"className\":\"info legend\",\"group\":null}]}],\"limits\":{\"lat\":[-22.30167511442247,-9.43319665099512],\"lng\":[159.9416228307579,178.4531516996874]},\"setView\":[[-18.14982816574846,178.4531516996874],12,[]]},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n\n|          |                                                 |\n|:---------|:------------------------------------------------|\n|Code      |SUVA                                             |\n|City      |Suva                                             |\n|Country   |Fiji                                             |\n|Latitude  |-18.1498                                         |\n|Longitude |178.4532                                         |\n|Curator   |Marika Tuiwawa (University of the South Pacific) |\n\n\n:::\n:::\n\n\n## Description\n\nThe [South Pacific Regional Herbarium](https://ias.usp.ac.fj/our-units/sprh/) (SUVA), now part of the South Pacific Regional Herbarium and Biodiversity Centre, is managed by the University of the South Pacific through its Institute of Applied Sciences in Suva. It was founded in 1933 as the Fiji Herbarium, and the university took over its management in 1982. It holds about 90,000 specimens from Fiji and many other Pacific islands, including Nauru, New Caledonia, Norfolk Island, Pitcairn, Samoa, the Solomon Islands, Tonga and Vanuatu.\n\nMost specimens are databased and about 20,000 have been digitised. The checklist of Fijian plant species, based on *Flora Vitiensis Nova* (A.C. Smith, 1979–1996), needs to be updated.\n\n## Herbarium team\n\nMarika Tuiwawa and two permanent staff members.\n\n[← All herbaria](../herbaria.qmd) · [Network map](../index.qmd)\n",
